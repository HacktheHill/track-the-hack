{
	"name": "track-the-hack",
	"version": "0.1.0",
	"private": true,
	"engines": {
		"node": ">=24.0.0 <25"
	},
	"overrides": {
		"uuid": "11.1.1",
		"google-auth-library": "$google-auth-library",
		"postcss": "$postcss",
		"serialize-javascript": "7.0.7"
	},
	"scripts": {
		"build": "next build --webpack",
		"dev": "next dev --webpack --hostname 127.0.0.1",
		"dev:participant": "node --env-file=.env scripts/dev-participant.mjs",
		"dev:setup": "node scripts/setup-dev.mjs && node --env-file=.env scripts/assert-local-dev-db.mjs && docker compose up -d --wait && prisma migrate deploy && prisma db seed",
		"preview": "npm run build && next start --hostname 127.0.0.1",
		"test": "node --import tsx --test test/**/*.test.ts test/**/*.test.tsx",
		"test:e2e:dev": "npm run dev:setup && NEXT_DIST_DIR=.next-dev-e2e node --env-file=.env --import tsx scripts/test-dev-e2e.mts",
		"test:e2e:discord": "npm run dev:setup && node --env-file=.env --import tsx scripts/test-discord-e2e.mts",
		"test:e2e:pwa": "npm run dev:setup && NEXT_DIST_DIR=.next-pwa-e2e node scripts/run-pwa-e2e.mjs",
		"typecheck": "tsc --noEmit && node scripts/check-google-apps-script.mjs",
		"verify:dev": "npm test && npm run typecheck && npm run lint && npm run test:e2e:dev && npm run test:e2e:pwa",
		"organizer:provision": "node --env-file-if-exists=.env --import tsx scripts/provision-organizer.mts",
		"postinstall": "prisma generate",
		"lint": "eslint src prisma scripts test integrations/google-sheets/Code.gs next.config.js next-i18next.config.js tailwind.config.mjs --ext .gs,.js,.mjs,.ts,.tsx,.mts",
		"start": "next start",
		"format": "prettier --write ."
	},
	"dependencies": {
		"@google-cloud/local-auth": "^3.0.0",
		"@next-auth/prisma-adapter": "^1.0.7",
		"@prisma/client": "^6.19.3",
		"@tanstack/react-query": "^4.36.1",
		"@trpc/client": "^10.45.3",
		"@trpc/next": "^10.45.3",
		"@trpc/react-query": "^10.45.3",
		"@trpc/server": "^10.45.3",
		"@types/web-push": "^3.6.4",
		"argon2": "^0.41.1",
		"csvtojson": "^2.0.14",
		"google-auth-library": "^10.9.0",
		"googleapis": "^150.0.1",
		"i18next": "^26.3.6",
		"mimetext": "^3.0.28",
		"next": "^16.3.4",
		"next-auth": "^4.24.15",
		"next-i18next": "^15.4.3",
		"next-pwa": "^5.6.0",
		"prisma": "^6.19.3",
		"qr-scanner": "^1.4.2",
		"qrcode": "^1.5.4",
		"raw-loader": "^4.0.2",
		"react": "18.3.1",
		"react-dom": "18.3.1",
		"react-i18next": "^15.7.4",
		"react-markdown": "^9.0.1",
		"react-zoom-pan-pinch": "^3.3.0",
		"recharts": "^2.12.7",
		"rehype-autolink-headings": "^7.1.0",
		"rehype-slug": "^6.0.0",
		"remark-toc": "^9.0.0",
		"superjson": "2.2.1",
		"unified": "^11.0.5",
		"web-push": "^3.6.7",
		"zod": "^3.22.4",
		"zod-i18n-map": "^2.27.0"
	},
	"devDependencies": {
		"@faker-js/faker": "^10.5.0",
		"@types/google-apps-script": "^2.0.12",
		"@types/node": "^24.13.3",
		"@types/nodemailer": "^8.0.1",
		"@types/qrcode": "^1.5.6",
		"@types/react": "^18.3.3",
		"@types/react-dom": "^18.3.0",
		"@types/react-test-renderer": "18.3.1",
		"@types/smtp-server": "^3.5.13",
		"@typescript-eslint/eslint-plugin": "^5.51.0",
		"@typescript-eslint/parser": "^5.51.0",
		"autoprefixer": "^10.4.16",
		"eslint": "^8.56.0",
		"eslint-config-next": "^15.5.20",
		"nodemailer": "^9.1.1",
		"playwright-core": "1.62.1",
		"postcss": "^8.5.26",
		"prettier": "^3.1.1",
		"prettier-plugin-tailwindcss": "^0.5.9",
		"react-test-renderer": "18.3.1",
		"smtp-server": "^3.19.6",
		"tailwindcss": "^3.3.7",
		"tsx": "4.23.0",
		"typescript": "^5.9.3",
		"webpack": "5.111.1",
		"workbox-build": "6.6.0"
	},
	"ct3aMetadata": {
		"initVersion": "7.3.1"
	},
	"prisma": {
		"seed": "tsx prisma/seeders/index.mts"
	}
}