// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider     = "mysql"
  // NOTE: When using postgresql, mysql or sqlserver, uncomment the @db.Text annotations in model Account below
  // Further reading:
  // https://next-auth.js.org/adapters/prisma#create-the-prisma-schema
  // https://www.prisma.io/docs/reference/api-reference/prisma-schema-reference#string
  url          = env("DATABASE_URL")
  relationMode = "prisma"
}

// Necessary for Next auth
model Account {
  id                       String   @id @default(cuid())
  userId                   String
  type                     String
  provider                 String
  providerAccountId        String
  refresh_token            String?  @db.Text
  refresh_token_expires_in Int?
  access_token             String?  @db.Text
  expires_at               Int?
  token_type               String?
  scope                    String?
  id_token                 String?  @db.Text
  session_state            String?
  ext_expires_in           Int?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @default(now()) @updatedAt
  user                     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  image         String?
  emailVerified DateTime?
  roles         Role[]
  accounts      Account[]
  sessions      Session[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @default(now()) @updatedAt
}

model Role {
  id        String   @id @default(cuid())
  name      RoleName @unique
  users     User[]
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model Hacker {
  // Supplied by the authoritative Sheet. It has no generated default on purpose.
  id               String       @id
  tShirtSize       TShirtSize
  mealCategory     MealCategory
  confirmed        Boolean      @default(false)
  walkIn           Boolean      @default(false)
  acceptanceExpiry DateTime

  presences              Presence[]
  eventInterests         EventInterest[]
  cancellationCapability CancellationCapability?
  claimToken             ClaimToken?
  participantSession     ParticipantSession?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

// The raw cancellation token is never persisted. A token contains this random
// capability id plus an HMAC generated from the server-only cancellation key.
model CancellationCapability {
  id        String   @id
  hackerId  String   @unique
  hacker    Hacker   @relation(fields: [hackerId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

// The raw claim token is never persisted. A token contains this random claim id
// plus an HMAC generated from the server-only claim key. One row per hacker, so
// issuing access again replaces a token that has not been used yet.
model ClaimToken {
  id         String    @id
  hackerId   String    @unique
  hacker     Hacker    @relation(fields: [hackerId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @default(now()) @updatedAt
}

// The browser holds the random session capability. Only its keyed verifier is
// stored here, so a database read cannot be turned into an active session.
// hackerId is unique because replacement access permits exactly one device.
model ParticipantSession {
  verifier  String   @id
  hackerId  String   @unique
  hacker    Hacker   @relation(fields: [hackerId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model Presence {
  id        String   @id @default(cuid())
  value     Int
  label     String
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  Hacker    Hacker   @relation(fields: [hackerId], references: [id], onDelete: Cascade)
  hackerId  String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId   String

  @@unique([hackerId, eventId])
  @@index([eventId])
}

model Event {
  id                     String          @id @default(cuid())
  importKey              String?         @unique
  seriesKey              String?
  start                  DateTime
  end                    DateTime
  hidden                 Boolean         @default(false)
  name                   String
  nameFr                 String
  type                   EventType       @default(ALL)
  interests              EventInterest[]
  scannerWorkflow        ScannerWorkflow @default(ATTENDANCE)
  host                   String?
  description            String          @db.Text
  descriptionFr          String          @db.Text
  room                   String
  roomFr                 String?
  image                  String?
  link                   String?
  linkText               String?
  linkTextFr             String?
  maxCheckIns            Int?
  notifiedAt             DateTime?
  notificationLeaseToken String?
  notificationLeaseUntil DateTime?
  presences              Presence[]
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @default(now()) @updatedAt

  @@index([seriesKey, start])
}

model PushSubscription {
  id        String   @id @default(cuid())
  eventId   String
  endpoint  String   @db.VarChar(512)
  p256dh    String
  auth      String
  locale    String   @default("en") @db.VarChar(2)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([eventId, endpoint])
  @@index([eventId])
}

model Log {
  id         Int      @id @default(autoincrement())
  timestamp  DateTime @default(now())
  sourceId   String
  sourceType String
  author     String   @default("")
  route      String
  action     String
  details    String?  @db.Text
  userId     String?

  @@index([userId])
}

model Hardware {
  id                String   @id @default(cuid())
  imageURL          String?
  name              String
  quantityAvailable Int?
  manufacturer      String?
  model             String?
  type              String?
  description       String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @default(now()) @updatedAt

  @@index([name])
}

enum RoleName {
  ADMIN
  ORGANIZER
  MAYOR
  PREMIER
}

enum EventType {
  ALL
  GENERAL
  COMPETITION
  WORKSHOP
  SOCIAL
  CAREER_FAIR
  FOOD
}

enum ScannerWorkflow {
  CHECK_IN
  MERCHANDISE
  FOOD
  ATTENDANCE
}

enum TShirtSize {
  XS
  S
  M
  L
  XL
  XXL
  NONE
}

enum MealCategory {
  STANDARD
  VEGETARIAN
  VEGAN
  HALAL
  OTHER
}

model EventInterest {
  id        String   @id @default(cuid())
  hackerId  String
  eventId   String
  createdAt DateTime @default(now())
  Hacker    Hacker   @relation(fields: [hackerId], references: [id], onDelete: Cascade)
  Event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([hackerId, eventId])
  @@index([eventId])
}
