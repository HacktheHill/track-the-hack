// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider     = "mysql"
  // NOTE: When using postgresql, mysql or sqlserver, uncomment the @db.Text annotations in model Account below
  // Further reading:
  // https://next-auth.js.org/adapters/prisma#create-the-prisma-schema
  // https://www.prisma.io/docs/reference/api-reference/prisma-schema-reference#string
  url          = env("DATABASE_URL")
  relationMode = "prisma"
}

// Necessary for Next auth
model Account {
  id                       String   @id @default(cuid())
  userId                   String
  type                     String
  provider                 String
  providerAccountId        String
  refresh_token            String?  @db.Text
  refresh_token_expires_in Int?
  access_token             String?  @db.Text
  expires_at               Int?
  token_type               String?
  scope                    String?
  id_token                 String?  @db.Text
  session_state            String?
  ext_expires_in           Int?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @default(now()) @updatedAt
  user                     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model User {
  id                      String                        @id @default(cuid())
  name                    String?
  email                   String?                       @unique
  image                   String?
  emailVerified           DateTime?
  isAdmin                 Boolean                       @default(false)
  disabledAt              DateTime?
  accounts                Account[]
  sessions                Session[]
  presences               OrganizerPresence[]
  hardwareLoansCheckedOut HardwareLoan[]                @relation("HardwareCheckoutOrganizer")
  hardwareReturns         HardwareReturn[]
  latteStateUpdates       LatteLabState[]
  latteIngredientUpdates  LatteIngredientAvailability[]
  latteOrdersHandled      LatteOrder[]                  @relation("LatteOrderHandler")
  createdAt               DateTime                      @default(now())
  updatedAt               DateTime                      @default(now()) @updatedAt
}

// Organiser scans are intentionally separate from participant Presence rows:
// organisers do not have participant dietary, merchandise, or RSVP data.
model OrganizerPresence {
  id          String   @id @default(cuid())
  value       Int
  label       String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt
  organizer   User     @relation(fields: [organizerId], references: [id], onDelete: Cascade)
  organizerId String
  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId     String

  @@unique([organizerId, eventId])
  @@index([eventId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Explicit access for organisers who do not use a CTN Google Workspace
// account. The email may be added before its owner signs in for the first time.
model OrganizerAccess {
  id          String   @id @default(cuid())
  email       String   @unique
  createdById String
  createdAt   DateTime @default(now())

  @@index([createdAt])
}

model Hacker {
  // Supplied by the authoritative Sheet. It has no generated default on purpose.
  id               String       @id
  tShirtSize       TShirtSize
  mealCategory     MealCategory
  confirmed        Boolean      @default(false)
  rsvpRespondedAt  DateTime?
  walkIn           Boolean      @default(false)
  acceptanceExpiry DateTime

  presences              Presence[]
  eventInterests         EventInterest[]
  cancellationCapability CancellationCapability?
  claimToken             ClaimToken?
  participantSession     ParticipantSession?
  hardwareLoans          HardwareLoan[]
  latteOrders            LatteOrder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

// The raw cancellation token is never persisted. A token contains this random
// capability id plus an HMAC generated from the server-only cancellation key.
model CancellationCapability {
  id        String   @id
  hackerId  String   @unique
  hacker    Hacker   @relation(fields: [hackerId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

// The raw claim token is never persisted. A token contains this random claim id
// plus an HMAC generated from the server-only claim key. One row per hacker, so
// issuing access again replaces a token that has not been used yet.
model ClaimToken {
  id         String    @id
  hackerId   String    @unique
  hacker     Hacker    @relation(fields: [hackerId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @default(now()) @updatedAt
}

// The browser holds the random session capability. Only its keyed verifier is
// stored here, so a database read cannot be turned into an active session.
// hackerId is unique because replacement access permits exactly one device.
model ParticipantSession {
  verifier  String   @id
  hackerId  String   @unique
  hacker    Hacker   @relation(fields: [hackerId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model Presence {
  id        String   @id @default(cuid())
  value     Int
  label     String
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  Hacker    Hacker   @relation(fields: [hackerId], references: [id], onDelete: Cascade)
  hackerId  String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId   String

  @@unique([hackerId, eventId])
  @@index([eventId])
}

model Event {
  id                     String              @id @default(cuid())
  importKey              String?             @unique
  seriesKey              String?
  start                  DateTime
  end                    DateTime
  hidden                 Boolean             @default(false)
  name                   String
  nameFr                 String
  type                   EventType           @default(ALL)
  interests              EventInterest[]
  scannerEnabled         Boolean             @default(true)
  scannerWorkflow        ScannerWorkflow     @default(ATTENDANCE)
  host                   String?
  description            String              @db.Text
  descriptionFr          String              @db.Text
  room                   String
  roomFr                 String?
  image                  String?
  link                   String?
  linkText               String?
  linkTextFr             String?
  maxCheckIns            Int?
  notifiedAt             DateTime?
  notificationLeaseToken String?
  notificationLeaseUntil DateTime?
  presences              Presence[]
  organizerPresences     OrganizerPresence[]
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @default(now()) @updatedAt

  @@index([seriesKey, start])
}

model PushSubscription {
  id        String   @id @default(cuid())
  eventId   String
  endpoint  String   @db.VarChar(512)
  p256dh    String
  auth      String
  locale    String   @default("en") @db.VarChar(2)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([eventId, endpoint])
  @@index([eventId])
}

model Log {
  id         Int      @id @default(autoincrement())
  timestamp  DateTime @default(now())
  sourceId   String
  sourceType String
  author     String   @default("")
  route      String
  action     String
  details    String?  @db.Text
  userId     String?

  @@index([userId])
}

// Append-only, versioned operational audit ledger. Identifier fields are
// deliberately not foreign keys so the evidence survives source-record removal.
model AuditEvent {
  id            String   @id
  schemaVersion Int      @default(1)
  occurredAt    DateTime
  name          String
  outcome       String
  correlationId String
  actorType     String
  actorId       String
  subjectType   String?
  subjectId     String?
  resourceType  String?
  resourceId    String?
  data          Json
  createdAt     DateTime @default(now())

  @@index([actorId, occurredAt])
  @@index([subjectType, subjectId, occurredAt])
  @@index([resourceType, resourceId, occurredAt])
  @@index([name, outcome, occurredAt])
  @@index([occurredAt])
}

model Hardware {
  id                String   @id @default(cuid())
  imageURL          String?
  name              String
  quantityAvailable Int?
  manufacturer      String?
  model             String?
  type              String?
  description       String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @default(now()) @updatedAt

  @@index([name])
}

// The legacy Hardware table above is retained so the guarded initial importer
// can refuse to proceed if it contains unexpected historical data.
model HardwareItem {
  id                   String                @id @default(cuid())
  importKey            String                @unique
  category             HardwareCategory
  inventoryMode        HardwareInventoryMode @default(COUNTED)
  name                 String
  normalizedName       String
  description          String?               @db.Text
  imageURL             String?
  totalQuantity        Int?
  availableQuantity    Int?
  availableForCheckout Boolean               @default(true)
  consumptionAllowed   Boolean               @default(false)
  damagedQuantity      Int                   @default(0)
  missingQuantity      Int                   @default(0)
  consumedQuantity     Int                   @default(0)
  active               Boolean               @default(true)
  loanLines            HardwareLoanLine[]
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @default(now()) @updatedAt

  @@unique([category, normalizedName])
  @@index([name])
}

model HardwareLoan {
  id                  String             @id @default(cuid())
  hackerId            String
  hacker              Hacker             @relation(fields: [hackerId], references: [id], onDelete: Restrict)
  pickupName          String?
  checkoutOrganizerId String
  checkoutOrganizer   User               @relation("HardwareCheckoutOrganizer", fields: [checkoutOrganizerId], references: [id], onDelete: Restrict)
  checkoutKey         String             @unique
  status              HardwareLoanStatus @default(OPEN)
  idCollectedAt       DateTime
  idReturnedAt        DateTime?
  checkedOutAt        DateTime           @default(now())
  closedAt            DateTime?
  lines               HardwareLoanLine[]
  returns             HardwareReturn[]
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @default(now()) @updatedAt

  @@index([hackerId, status])
  @@index([pickupName])
  @@index([checkoutOrganizerId])
}

model HardwareLoanLine {
  id               String               @id @default(cuid())
  loanId           String
  loan             HardwareLoan         @relation(fields: [loanId], references: [id], onDelete: Cascade)
  itemId           String
  item             HardwareItem         @relation(fields: [itemId], references: [id], onDelete: Restrict)
  borrowedQuantity Int
  goodQuantity     Int                  @default(0)
  damagedQuantity  Int                  @default(0)
  missingQuantity  Int                  @default(0)
  consumedQuantity Int                  @default(0)
  returnLines      HardwareReturnLine[]

  @@unique([loanId, itemId])
  @@index([itemId])
}

model HardwareReturn {
  id             String               @id @default(cuid())
  loanId         String
  loan           HardwareLoan         @relation(fields: [loanId], references: [id], onDelete: Restrict)
  organizerId    String
  organizer      User                 @relation(fields: [organizerId], references: [id], onDelete: Restrict)
  idempotencyKey String               @unique
  returnedAt     DateTime             @default(now())
  lines          HardwareReturnLine[]

  @@index([loanId])
  @@index([organizerId])
}

model HardwareReturnLine {
  id               String           @id @default(cuid())
  returnId         String
  hardwareReturn   HardwareReturn   @relation(fields: [returnId], references: [id], onDelete: Cascade)
  loanLineId       String
  loanLine         HardwareLoanLine @relation(fields: [loanLineId], references: [id], onDelete: Restrict)
  goodQuantity     Int              @default(0)
  damagedQuantity  Int              @default(0)
  missingQuantity  Int              @default(0)
  consumedQuantity Int              @default(0)

  @@unique([returnId, loanLineId])
  @@index([loanLineId])
}

model LatteLabState {
  id                   Int      @id @default(1)
  open                 Boolean  @default(false)
  updatedByOrganizerId String?
  updatedByOrganizer   User?    @relation(fields: [updatedByOrganizerId], references: [id], onDelete: SetNull)
  updatedAt            DateTime @default(now()) @updatedAt

  @@index([updatedByOrganizerId])
}

model LatteIngredientAvailability {
  ingredient           LatteIngredient @id
  available            Boolean         @default(true)
  updatedByOrganizerId String?
  updatedByOrganizer   User?           @relation(fields: [updatedByOrganizerId], references: [id], onDelete: SetNull)
  updatedAt            DateTime        @default(now()) @updatedAt

  @@index([updatedByOrganizerId])
}

model LatteOrder {
  id                   String                   @id @default(cuid())
  hackerId             String
  hacker               Hacker                   @relation(fields: [hackerId], references: [id], onDelete: Restrict)
  activeHackerId       String?                  @unique
  pickupName           String?
  drink                LatteDrink
  temperature          LatteTemperature
  milkBase             LatteMilkBase
  flavour              LatteFlavour
  sweetener            LatteSweetener
  status               LatteOrderStatus         @default(QUEUED)
  submissionKey        String                   @unique
  cancellationReason   LatteCancellationReason?
  handledByOrganizerId String?
  handledByOrganizer   User?                    @relation("LatteOrderHandler", fields: [handledByOrganizerId], references: [id], onDelete: SetNull)
  submittedAt          DateTime                 @default(now())
  preparingAt          DateTime?
  readyAt              DateTime?
  completedAt          DateTime?
  cancelledAt          DateTime?
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @default(now()) @updatedAt
  transitions          LatteOrderTransition[]

  @@index([hackerId, status])
  @@index([status, submittedAt])
  @@index([handledByOrganizerId])
}

model LatteOrderTransition {
  id          String           @id @default(cuid())
  orderId     String
  order       LatteOrder       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  requestKey  String           @unique
  fromStatus  LatteOrderStatus
  toStatus    LatteOrderStatus
  organizerId String
  createdAt   DateTime         @default(now())

  @@index([orderId])
  @@index([organizerId])
}

enum HardwareCategory {
  INPUTS
  OUTPUTS
  MICROCONTROLLERS
  MISCELLANEOUS
}

enum HardwareInventoryMode {
  COUNTED
  UNCOUNTED
}

enum HardwareLoanStatus {
  OPEN
  CLOSED
  CLOSED_WITH_MISSING
}

enum LatteDrink {
  COFFEE
  DECAF_COFFEE
  LATTE
  MOCHA
  CHAI_LATTE
  LONDON_FOG
  TEA
  HOT_CHOCOLATE
}

enum LatteTemperature {
  HOT
  ICED
}

enum LatteMilkBase {
  NONE
  WATER
  DAIRY
  OAT
  ALMOND
}

enum LatteFlavour {
  NONE
  FRENCH_VANILLA
  CARAMEL
  BROWN_SUGAR_CINNAMON
  CHOCOLATE
}

enum LatteSweetener {
  NONE
  SUGAR
  SUBSTITUTE
}

enum LatteIngredient {
  COFFEE
  DECAF
  ICE
  DAIRY_MILK
  OAT_MILK
  ALMOND_MILK
  FRENCH_VANILLA
  CARAMEL
  BROWN_SUGAR_CINNAMON
  CHOCOLATE
  CHAI_CONCENTRATE
  EARL_GREY
  TEA
  HOT_CHOCOLATE_MIX
  SUGAR
  SUGAR_SUBSTITUTE
}

enum LatteOrderStatus {
  QUEUED
  PREPARING
  READY
  COMPLETED
  CANCELLED
}

enum LatteCancellationReason {
  PARTICIPANT_CANCELLED
  INGREDIENT_UNAVAILABLE
  DUPLICATE
  UNCLAIMED
  OTHER
}

enum EventType {
  ALL
  GENERAL
  COMPETITION
  WORKSHOP
  SOCIAL
  CAREER_FAIR
  FOOD
}

enum ScannerWorkflow {
  CHECK_IN
  MERCHANDISE
  FOOD
  ATTENDANCE
}

enum TShirtSize {
  XS
  S
  M
  L
  XL
  XXL
  NONE
}

enum MealCategory {
  STANDARD
  VEGETARIAN
  VEGAN
  HALAL
  OTHER
}

model EventInterest {
  id        String   @id @default(cuid())
  hackerId  String
  eventId   String
  createdAt DateTime @default(now())
  Hacker    Hacker   @relation(fields: [hackerId], references: [id], onDelete: Cascade)
  Event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([hackerId, eventId])
  @@index([eventId])
}
