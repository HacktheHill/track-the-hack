# When adding additional env variables, the schema in /env/schema.mjs should be updated accordingly

# MySQL
MYSQL_ROOT_PASSWORD=root

# Prisma
DATABASE_URL="mysql://root:root@localhost/track-the-hack"

# Next Auth
# You can generate the secret via 'openssl rand -base64 32' on Linux
# More info: https://next-auth.js.org/configuration/options#secret
# NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Next Auth Google Provider
GOOGLE_CLIENT_ID=test
GOOGLE_CLIENT_SECRET=test

# Next Auth Discord Provider
DISCORD_CLIENT_ID=test
DISCORD_CLIENT_SECRET=test

# Next Auth GitHub Provider
GITHUB_CLIENT_ID=test
GITHUB_CLIENT_SECRET=test

# Next Auth Email Provider
EMAIL_SERVER_HOST=localhost
EMAIL_SERVER_PORT=1025
EMAIL_SERVER_USER=test
EMAIL_SERVER_PASSWORD=test
# Optional when the SMTP provider is Amazon SES.
SES_CONFIGURATION_SET=
EMAIL_FROM=test@example.com

# Sponsorship Gmail Drafts Google Auth
SPONSORSHIP_GOOGLE_CLIENT_ID=test
SPONSORSHIP_GOOGLE_CLIENT_SECRET=test
SPONSORSHIP_GOOGLE_REFRESH_TOKEN=test

# S3
S3_URL=http://localhost:9000
S3_AUTH_KEY=test

# Discord Bot
INTERNAL_API_SECRET=12345678901234567890123456789012
DISCORD_BOT_SECRET_KEY=
DISCORD_BOT_URL=http://localhost:4000

# QR Code Generator
QR_SECRET_KEY=

# Walk-Ins
WALK_IN_SECRET_KEY=
