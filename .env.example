# When adding additional env variables, the schema in /env/schema.mjs should be updated accordingly

# MySQL
MYSQL_ROOT_PASSWORD=root

# Prisma
DATABASE_URL="mysql://root:root@localhost/track-the-hack"

# Next Auth
# You can generate the secret via 'openssl rand -base64 32' on Linux
# More info: https://next-auth.js.org/configuration/options#secret
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Local-only organizer login. The app accepts this only when NEXTAUTH_URL is
# loopback, so LAN and deployed instances remain Google-only.
DEV_AUTH_ENABLED=1

# Sheet integration, RSVP cancellation, day-of claim tokens, participant sessions
# Generate independent values with: openssl rand -base64 32
SHEETS_INTEGRATION_API_KEY=
CANCELLATION_TOKEN_SECRET=
CLAIM_TOKEN_SECRET=
PARTICIPANT_SESSION_SECRET=

# Discord verification: set both to enable. Same shared secret on the bot.
# Local and production setup: docs/DISCORD_VERIFICATION.md
DISCORD_BOT_URL=
INTERNAL_API_SECRET=

# Sponsorship Gmail Drafts Google Auth
SPONSORSHIP_GOOGLE_CLIENT_ID=
SPONSORSHIP_GOOGLE_CLIENT_SECRET=
SPONSORSHIP_GOOGLE_REFRESH_TOKEN=

# Web push notifications
# Generate with: npx web-push generate-vapid-keys
# NEXT_PUBLIC_VAPID_PUBLIC_KEY must equal VAPID_PUBLIC_KEY at build time.
# Leave all keys blank to disable push. See docs/PUSH_NOTIFICATIONS.md.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=
