# When adding additional env variables, the schema in /env/schema.mjs should be updated accordingly

# MySQL
MYSQL_ROOT_PASSWORD=root

# Prisma
DATABASE_URL="mysql://root:root@localhost/track-the-hack"

# Next Auth
# You can generate the secret via 'openssl rand -base64 32' on Linux
# More info: https://next-auth.js.org/configuration/options#secret
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
EMAIL_SERVER_HOST=
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER=
EMAIL_SERVER_PASSWORD=
EMAIL_FROM=

# Local-only organizer login. The app accepts this only when NEXTAUTH_URL is
# loopback, so LAN and deployed instances use Google or allowed email links.
DEV_AUTH_ENABLED=1

# Sheet integration, RSVP cancellation, day-of claim tokens, participant sessions
# Generate independent values with: openssl rand -base64 32
SHEETS_INTEGRATION_API_KEY=
CANCELLATION_TOKEN_SECRET=
CLAIM_TOKEN_SECRET=
PARTICIPANT_SESSION_SECRET=

# Discord verification and participant DMs: set both to enable. The shared
# secret must match the bot. See docs/DISCORD_VERIFICATION.md and
# docs/NOTIFICATIONS.md.
DISCORD_BOT_URL=
INTERNAL_API_SECRET=

# Web push notifications
# Generate with: npx web-push generate-vapid-keys
# NEXT_PUBLIC_VAPID_PUBLIC_KEY must equal VAPID_PUBLIC_KEY at build time.
# Leave all keys blank to disable push. See docs/PUSH_NOTIFICATIONS.md and
# docs/NOTIFICATIONS.md.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=
